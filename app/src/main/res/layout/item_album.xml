<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="155dp"
    android:layout_marginEnd="15dp"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/imgPortadaAlbum"
        android:layout_width="155dp"
        android:layout_height="155dp"
        android:background="@color/black"
        android:scaleType="centerCrop"/>

    <TextView
        android:id="@+id/tvNombreAlbum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Nombre del album"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tvNombreArtista"
        app:layout_constraintTop_toTopOf="@+id/imgPortadaAlbum"
        app:layout_constraintVertical_bias="1.0"
        tools:layout_editor_absoluteX="0dp" />

    <TextView
        android:id="@+id/tvNombreArtista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Nombre del artista"
        android:textColor="#AEBABA"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteX="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>